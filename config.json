{
  "mode": "hybrid",
  "hotkey": {
    "ctrl_numlock": true,
    "double_tap_numlock": true,
    "double_tap_max_interval_ms": 400
  },
  "custom_bindings": {
    "toggle_layer": {
      "vk": 86,
      "ctrl": true,
      "alt": true,
      "shift": false,
      "win": false,
      "display": "Ctrl + Alt + V"
    },
    "volume_up": {
      "vk": 38,
      "ctrl": false,
      "alt": false,
      "shift": false,
      "win": false,
      "display": "Up Arrow"
    },
    "volume_down": {
      "vk": 40,
      "ctrl": false,
      "alt": false,
      "shift": false,
      "win": false,
      "display": "Down Arrow"
    },
    "next_app": {
      "vk": 39,
      "ctrl": false,
      "alt": false,
      "shift": false,
      "win": false,
      "display": "Right Arrow"
    },
    "prev_app": {
      "vk": 37,
      "ctrl": false,
      "alt": false,
      "shift": false,
      "win": false,
      "display": "Left Arrow"
    },
    "toggle_mute": {
      "vk": 77,
      "ctrl": false,
      "alt": false,
      "shift": false,
      "win": false,
      "display": "M"
    },
    "exit_layer": {
      "vk": 27,
      "ctrl": false,
      "alt": false,
      "shift": false,
      "win": false,
      "display": "Escape"
    }
  },
  "volume": {
    "step_percent": 5,
    "fine_step_percent": 2,
    "sound_feedback": true
  },
  "behavior": {
    "auto_hide_seconds": 6,
    "cycle_wraparound": true,
    "start_on_boot": false
  },
  "appearance": {
    "position": "top-center",
    "animation_enabled": true,
    "animation_duration_ms": 180,
    "margin_x": 28,
    "margin_y": 60,
    "width": 360,
    "max_visible_apps": 6,
    "accent_color": "#00E5A3",
    "bg_color": "#121318",
    "card_bg": "#1A1B24",
    "selected_bg": "#242838",
    "text_primary": "#FFFFFF",
    "text_secondary": "#8E90A6"
  }
}